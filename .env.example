# Copy to .env for local use. NEVER commit .env or real credentials.

# --- PostgreSQL (docker compose reads POSTGRES_*; the app and Alembic read DATABASE_URL) ---
POSTGRES_DB=predictive_maintenance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/predictive_maintenance
# DATABASE_POOL_SIZE=5

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SENSOR_TOPIC=sensor-readings
KAFKA_PREDICTION_TOPIC=predictions
KAFKA_ALERT_TOPIC=alerts
KAFKA_CONSUMER_GROUP=prediction-service
# KAFKA_AUTO_OFFSET_RESET=earliest
# KAFKA_TOPIC_PARTITIONS=3

# --- API / logging ---
LOG_LEVEL=INFO
# READINESS_CHECK_KAFKA=true
