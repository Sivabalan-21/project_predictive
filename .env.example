# Copy to .env for local use. NEVER commit .env or real credentials.
# Placeholder values below ("change-me...") are accepted ONLY when APP_ENV is development/test; with APP_ENV=production the
# API and the consumer refuse to start while JWT_SECRET or the database password still look like placeholders.

# --- Environment ---
APP_ENV=development                 # development | test | production   (anything else is rejected)
# ENABLE_DOCS=true                  # serve /docs, /redoc, /openapi.json. Default: on, except when APP_ENV=production
# LOG_FORMAT=json                   # json | text. Default: json in production, text otherwise (docker compose sets json)
LOG_LEVEL=INFO

# --- PostgreSQL ---
# docker compose reads POSTGRES_*. The database is published on 127.0.0.1:${POSTGRES_HOST_PORT} (default 5433, NOT 5432, so it
# does not clash with a PostgreSQL installed on your machine). Code running on the HOST uses DATABASE_URL with that port;
# containers talk to postgres:5432 on the compose network (compose builds their DATABASE_URL itself).
# For `docker compose --profile app` the password must be URL-safe, e.g.:  openssl rand -hex 24
POSTGRES_DB=predictive_maintenance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5433/predictive_maintenance
# DATABASE_POOL_SIZE=5

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SENSOR_TOPIC=sensor-readings
KAFKA_PREDICTION_TOPIC=predictions
KAFKA_ALERT_TOPIC=alerts
KAFKA_DLQ_TOPIC=sensor-readings.dlq   # dead-letter topic (invalid / un-predictable messages); must differ from the other three
KAFKA_CONSUMER_GROUP=prediction-service
# KAFKA_AUTO_OFFSET_RESET=earliest
# KAFKA_TOPIC_PARTITIONS=3

# --- API authentication (Phase 4) ---
# HS256 signing secret, >= 32 characters. Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-random-secret-of-at-least-32-characters
# READINESS_CHECK_KAFKA=true

# --- Consumer metrics (Phase 4) ---
# The consumer serves /metrics and /healthz on this address. Default is loopback only; 0 disables the endpoint.
# CONSUMER_METRICS_ADDR=127.0.0.1
# CONSUMER_METRICS_PORT=9101

# --- docker compose: published ports (all default to loopback; change deliberately, see docs/docker.md) ---
# API_PORT=8000
# API_BIND_ADDR=127.0.0.1
# POSTGRES_BIND_ADDR=127.0.0.1
# KAFKA_BIND_ADDR=127.0.0.1
# KAFKA_EXTERNAL_HOST=localhost
